# Salin file ini menjadi `.env` lalu sesuaikan nilainya. File `.env` tidak ikut ter-commit.

# --- Flask ---
# Buat nilai acak: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
FLASK_DEBUG=0
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# --- API PHP ---
PHP_API_BASE_URL=http://localhost/presensi_wajah/php
# Harus sama dengan 'api_key' di php/config.local.php
PHP_API_KEY=
HTTP_TIMEOUT=5

# --- Kamera & pengambilan wajah ---
CAMERA_INDEX=0
CAPTURE_SAMPLES=100
# Simpan juga foto wajah mentah ke python/captured_faces/ (default: tidak)
SAVE_CAPTURE_IMAGES=0

# --- Model pengenalan wajah ---
KNN_NEIGHBORS=3
SIMILARITY_THRESHOLD=0.2
BLINK_EAR_THRESHOLD=0.2

# --- Jadwal presensi (HH:MM atau HH:MM:SS) ---
JAM_MASUK=08:00:00
JAM_PULANG=16:00:00

# --- Notifikasi suara (butuh internet untuk gTTS) ---
SPEECH_ENABLED=1
